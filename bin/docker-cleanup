#!/usr/bin/env bash
set -uo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config_dir="${HOMELAB_CONFIG_DIR:-${HOME}/.config/homelab-ansible}"
inventory_file="${config_dir}/inventory.yml"
local_vars_file="${config_dir}/group_vars/local.yml"
limit="all"

usage() {
  echo "Usage: $0 [--limit all|LXC_TARGET|INVENTORY_HOST]"
  echo "Configuration: \${HOMELAB_CONFIG_DIR:-~/.config/homelab-ansible}"
}

while (($#)); do
  case "$1" in
    --limit)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      limit="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ "$limit" =~ ^[A-Za-z0-9_.:-]+$ ]] || {
  echo "Invalid --limit value: $limit" >&2
  exit 2
}
[[ -f "$inventory_file" ]] || {
  echo "External inventory not found: $inventory_file" >&2
  exit 2
}
[[ -f "$local_vars_file" ]] || {
  echo "External local variables not found: $local_vars_file" >&2
  exit 2
}

echo "Cleanup removes only dangling (untagged) Docker images for target: $limit"
echo "Images used by containers, volumes, networks and stopped containers are kept."
read -r -p "Type APPLY to continue: " confirmation
if [[ "$confirmation" != "APPLY" ]]; then
  echo "Cleanup cancelled; no command was run."
  exit 2
fi

ANSIBLE_ROLES_PATH="${repo_dir}/roles" ansible-playbook \
  -i "$inventory_file" \
  --extra-vars "@$local_vars_file" \
  --extra-vars "{\"workflow_limit\":\"$limit\"}" \
  "$repo_dir/playbooks/docker-cleanup.yml"
