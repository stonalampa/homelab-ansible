#!/usr/bin/env bash
set -u

scenario="${DOCKER_MOCK_SCENARIO:-success}"
log_file="${DOCKER_MOCK_LOG:?DOCKER_MOCK_LOG is required}"
printf '%s\n' "$*" >>"$log_file"

if [[ "$1" == "status" ]]; then
  if [[ "$scenario" == "skipped" ]]; then
    echo "status: stopped"
  else
    echo "status: running"
  fi
  exit 0
fi

case " $* " in
  *" docker --version "*)
    echo "Docker version mock"
    ;;
  *" docker compose version "*)
    if [[ "$scenario" == "success-v1" ]]; then
      echo "docker: 'compose' is not a docker command." >&2
      exit 1
    fi
    echo "Docker Compose plugin mock"
    ;;
  *" docker-compose version "*)
    echo "docker-compose standalone mock"
    ;;
  *" config --quiet "*)
    ;;
  *" pull "*)
    if [[ "$scenario" == "failed" ]]; then
      echo "mock pull failure" >&2
      exit 42
    fi
    echo "mock pull success"
    ;;
  *" up -d "*)
    echo "mock up success"
    ;;
  *" ps -q "*)
    echo "mock-container-id"
    ;;
  *" docker image prune --force "*)
    if [[ "$scenario" == "prune-failed" ]]; then
      echo "mock prune failure" >&2
      exit 43
    fi
    echo "Deleted Images:"
    echo "deleted: sha256:mock"
    echo
    echo "Total reclaimed space: 1.5GB"
    ;;
  *" df --output=pcent / "*)
    echo "Use%"
    echo " 42%"
    ;;
  *" docker inspect "*)
    if [[ "$scenario" == "unhealthy" ]]; then
      echo '/mock-app running unhealthy'
    elif [[ "$scenario" == "restarting" ]]; then
      echo '/mock-app restarting none'
    elif [[ "$scenario" == "starting" ]] \
         && [[ "$(grep -c ' docker inspect ' "$log_file")" -lt 2 ]]; then
      echo '/mock-app running starting'
    else
      echo '/mock-app running healthy'
    fi
    ;;
  *)
    echo "Unexpected mock pct invocation: $*" >&2
    exit 9
    ;;
esac
